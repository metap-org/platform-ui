  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@metap/ui": "link:../design-system",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "react-i18next": "^17.0.11",
    "zundo": "^2.3.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "openapi-typescript": "^7.4.4",
    "oxlint": "^1.71.0",
    "prettier": "^3.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "typescript": "~6.0.2"
  }
